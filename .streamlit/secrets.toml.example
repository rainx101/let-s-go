# Copy this file to `.streamlit/secrets.toml` and fill in real values.
# The real secrets.toml is gitignored — never commit it.

[app]
# Password to open the app (single-user gate).
password = "change-me"

[neon]
# Neon Postgres connection string (Neon dashboard -> Connect).
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
url = ""

